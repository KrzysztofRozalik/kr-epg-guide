# Nigdy nie commituj prawdziwych danych dostawcy.
KR_EPG_CONFIG=/app/config.yaml
KR_EPG_ADMIN_TOKEN=replace-with-64-random-characters
KR_EPG_DELIVERY_TOKEN=replace-with-another-64-random-characters

# Opcjonalnie: dostawca M3U / Xtream / Stalker.
IPTV_M3U_URL=
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=
STALKER_PORTAL_URL=
STALKER_MAC=
STALKER_SERIAL=

# Opcjonalne wzbogacanie filmów i seriali.
TMDB_API_TOKEN=

# Opcjonalna publikacja do Cloudflare R2 (S3 API).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kr-live-epg
